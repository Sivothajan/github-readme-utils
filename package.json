{
  "name": "github-readme-utils",
  "version": "0.1.0",
  "description": "A collection of utilities to enhance your GitHub README files.",
  "author": {
    "name": "Sivothayan",
    "email": "gh@sivothayan.com",
    "url": "https://sivothayan.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun scripts/pre-build.ts --pre-build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "generate:assets": "bun scripts/public-assets-generator.ts --generate-favicons",
    "prune:translations": "bun scripts/prune-translations.ts",
    "check:licenses": "bun scripts/third-party-packages-license-checker.ts",
    "create:licenses": "bun scripts/third-party-packages-license-maker.ts",
    "create:localeDisplayNames:json": "bun scripts/create-locale-display-name-json.ts",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.16",
    "canvg": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.554.0",
    "motion": "^12.40.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bunx eslint --cache --fix",
    "*.{json,md,css,html,ts,tsx}": "bunx prettier --write"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "baseline-browser-mapping": "^2.10.35",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.4",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "eslint": "9.39.4"
  }
}
