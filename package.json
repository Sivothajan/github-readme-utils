{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "github-readme-utils",
  "author": {
    "name": "senkanthal.org",
    "email": "contact@senkanthal.org",
    "url": "https://senkanthal.org"
  },
  "private": true,
  "scripts": {
    "dev:portless": "portless gh-readme-utils next dev",
    "dev": "next dev",
    "prebuild": "bun run scripts/pre-build.ts --pre-build",
    "build": "next build",
    "start:portless": "portless gh-readme-utils next start",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "generate:assets": "bun scripts/public-assets-generator.ts --generate-favicons",
    "check:licenses": "bun scripts/third-party-packages-license-checker.ts",
    "create:licenses": "bun scripts/third-party-packages-license-maker.ts",
    "create:localeDisplayNames:json": "bun scripts/create-locale-display-name-json.ts",
    "prune:code:check": "ts-prune",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.16",
    "canvg": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.554.0",
    "motion": "^12.40.0",
    "next": "16.0.10",
    "raw-loader": "^4.0.2",
    "react": "19.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "simple-icons": "^16.23.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bunx eslint --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "*.{json,md,css,html,ts,tsx}": "bunx prettier --write"
  },
  "portless": {
    "name": "gh-readme-utils"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "png-to-ico": "^3.0.1",
    "portless": "^0.13.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "eslint": "9.39.4"
  }
}
